@startuml

class boardLogic.GameManager{
- ruleManager : boardLogic.RuleManager
- boardManager : Boardmanager
- guiManager : GUIManager
- playerWhite : players.PlayerEntity
- playerBlack : players.PlayerEntity
- currentPlayer : players.PlayerEntity
--
+ startGame()
+ switchPlayer()
+ getWinner()
+ handleMove()
+ undoMove()
+ redoMove()
+ saveGame()
+ loadGame()
}

class boardLogic.RuleManager{
--
+ isMoveValid() : boolean
+ isMillFormed() : boolean
+ isGameOver() : boolean
+ isPlayerBlocked() : boolean
+ isTimeOver() : boolean
+ isStalemate() : boolean
}

class boardLogic.BoardManager{
- nodes : Nodes[][]
--
- initializeBoard()
+ placeStone()
+ removeStone()
+ moveStone()
}

class GUIManager{
- gameManager : boardLogic.GameManager
- boardPanel : JPanel
- controlPanel : JPanel
--
- initializeGUI()
+ updateBoard()
+ undo()
+ redo()
+ restart()
+ save()
+ load()
+ setDifficulty()
}

interface phases.GamePhase{
--
+ {abstract} handleMove()
}

class phases.SettingPhase{
--
+ handleMove()
}

class phases.MovingPhase{
--
+ handleMove()
}

class phases.JumpingPhase{
--
+ handleMove()
}

class phases.GameOverPhase{
--
+ handleMove()
}

class boardLogic.Stone{
- owner : players.PlayerEntity
- currentNode : boardLogic.Node
--
+ moveToNode()
}

class boardLogic.Node{
- position : Position
--
+ isOccupied()
}

abstract class players.PlayerEntity{
# name : String
# stones : List<Stones>
# currentState : phases.GamePhase
--
+ {abstract} makeMove()
+ handleMove()
+ removeStone()
+ setState()
+ allStonesPlaced()
+ getRemainingStones()
+ getName()
}

class players.Player{
--
+ makeMove()
}

class players.CPUPlayer{
- strategy : 
--
+ makeMove()
+ setDifficulty()
}

class persistance.History{
- moves : Stack<persistance.Move>
- redoMoves : Stack<persistance.Move>
--
+ addMove()
+ undo() : persistance.Move
+ redo() : persistance.Move
+ clearRedo()
}

class persistance.Move{
- stone : boardLogic.Stone
- fromNode : boardLogic.Node
- toNode : boardLogic.Node
- removedStone : boardLogic.Stone
- currentState : phases.GamePhase
}

class view.Observable{
- observers : view.Observer[]
--
+ addObserver()
+ removeObserver()
+ notifyObservers()
}

class view.Observer{
- observable : view.Observable
--
+ update()
}

interface difficulties.DifficultyStrategy{
+ calculateMove()
}

class difficulties.EasyDifficulty{
+ calculateMove()
}

class difficulties.MediumDifficulty{
+ calculateMove()
}

class difficulties.HardDifficulty{
+ calculateMove()
}

boardLogic.RuleManager -o boardLogic.GameManager
GUIManager o-- boardLogic.GameManager
boardLogic.GameManager o- boardLogic.BoardManager
persistance.History -- boardLogic.GameManager
boardLogic.GameManager o-- players.PlayerEntity

phases.GamePhase <|.. phases.SettingPhase
phases.GamePhase <|.. phases.JumpingPhase
phases.GamePhase <|.. phases.MovingPhase
phases.GamePhase <|.. phases.GameOverPhase
phases.GamePhase -o players.PlayerEntity

players.PlayerEntity <|-- players.Player
players.PlayerEntity <|-- players.CPUPlayer
players.CPUPlayer o- difficulties.DifficultyStrategy
players.PlayerEntity *- boardLogic.Stone

difficulties.DifficultyStrategy <|.. difficulties.EasyDifficulty
difficulties.DifficultyStrategy <|.. difficulties.MediumDifficulty
difficulties.DifficultyStrategy <|.. difficulties.HardDifficulty

boardLogic.BoardManager *-- boardLogic.Node
boardLogic.BoardManager -|> view.Observable
boardLogic.Stone *- boardLogic.Node
boardLogic.Node - boardLogic.Node

persistance.Move - persistance.History

GUIManager -|> view.Observer

@enduml
