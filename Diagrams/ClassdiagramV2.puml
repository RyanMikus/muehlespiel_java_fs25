@startuml

class GameManager{
- {static} instance : GameManager
- ruleManager : RuleManager
- boardManager : Boardmanager
- guiManager : GUI
- playerWhite : PlayerEntity
- playerBlack : PlayerEntity
- currentPlayer : PlayerEntity
+ winner : Winner
+ noMillTurnCounter : int
--
- GameManager()
+ {static} getInstance() : GameManager
+ startGame()
+ switchPlayer()
+ getWinner() : PlayerEntity
+ handleMove()
+ undoMove()
+ redoMove()
+ saveGame()
+ loadGame()
}

enum Winner{
DRAW
WHITE
BLACK
}

class RuleManager{
- {static} instance : RuleManager
- {static} boardManager : BoardManager
- {static} gameManager : GameManager
--
- RuleManager()
+ {static} getInstance() : RuleManager
+ isMoveValid() : boolean
+ countNewMills() : int
+ isGameOver() : boolean
+ isPlayerGameOver() : boolean
+ isPlayerBlocked() : boolean
+ isStalemate() : boolean
+ isTimeOver() : boolean
}

class BoardManager{
- {static} instance : BoardManager
- ruleManager : RuleManager
- nodes : Map<int, Node>
- neighbors : int[][]
- potentialMills : List<int[]>
--
- BoardManager()
+ {static} getInstance : BoardManager
- initializeBoard()
- initializeMills()
- connectNodes()
+ placeStone() : boolean
+ removeStone() : boolean
+ moveStone() : boolean
+ getNode() : Node
}

class GUI{
- gameManager : GameManager
- boardPanel : JPanel
- controlPanel : JPanel
--
- initializeGUI()
+ updateBoard()
+ undo()
+ redo()
+ restart()
+ save()
+ load()
+ setDifficulty()
}

interface GamePhase{
# playerEntity : PlayerEntity
--
# GamePhase()
+ {abstract} handleMove() : boolean
+ {abstract} nextPhase()
}

class SettingPhase{
--
+ SettingPhase()
+ handleMove() : boolean
+ nextPhase()
}

class MovingPhase{
--
+ MovingPhase()
+ handleMove() : boolean
+ nextPhase()
}

class JumpingPhase{
--
+ JumpingPhase()
+ handleMove() : boolean
+ nextPhase()
}

class GameOverPhase{
--
+ GameOverPhase()
+ handleMove() : boolean
+ nextPhase()
}

class Stone{
- owner : PlayerEntity
- currentNode : Node
--
+ Stone()
+ setNode()
+ getNode() : Node
+ getOwner() : PlayerEntity
}

class Node{
- id : int
- stone : Stone
- neighbors : List<Node>
--
+ Node()
+ isOccupied() : boolean
+ addNeighbor()
+ getNeighbors() : List<Node>
+ placeStone()
+ removeStone()
+ getID() : int
+ getStone() : Stone
}

abstract class PlayerEntity{
# name : String
# stones : List<Stones>
# currentState : GameState
# placedStones : int
--
# PlayerEntity()
+ {abstract} makeMove() : Node
+ addStone()
+ removeStone()
+ stonePlaced()
+ allStonesPlaced() : boolean
+ getRemainingStones() : List<Stone>
+ getName() : String
+ getPhase() : GamePhase
+ setPhase()
}

class Player{
--
+ Player()
+ makeMove() : Node
}

class CPUPlayer{
- strategy : DifficultyStrategy
--
+ CPUPlayer()
+ makeMove() : Node
+ setDifficulty()
}

class History{
- moves : Stack<Move>
- redoMoves : Stack<Move>
--
+ addMove()
+ undo() : Move
+ redo() : Move
+ clearRedo()
}

class Move{
- stone : Stone
- fromNode : Node
- toNode : Node
- removedStone : Stone
- currentState : GameState
}

class Observable{
- observers : Observer[]
--
+ addObserver()
+ removeObserver()
+ notifyObservers()
}

class Observer{
- observable : Observable
--
+ update()
}

interface DifficultyStrategy{
+ calculateMove()
}

class EasyDifficulty{
+ calculateMove()
}

class MediumDifficulty{
+ calculateMove()
}

class HardDifficulty{
+ calculateMove()
}

BoardManager o- RuleManager
GUI o-- GameManager
GameManager o- BoardManager
Winner - GameManager
History - GameManager
GameManager o-- PlayerEntity

GameState <|-- SettingPhase
GameState <|-- JumpingPhase
GameState <|-- MovingPhase
GameState <|-- GameOverPhase
GameState -o PlayerEntity

Player -|> PlayerEntity
PlayerEntity <|-- CPUPlayer
CPUPlayer o-- DifficultyStrategy
PlayerEntity *- Stone

DifficultyStrategy <|.. EasyDifficulty
DifficultyStrategy <|.. MediumDifficulty
DifficultyStrategy <|.. HardDifficulty

BoardManager *-- Node
Observable <|-- BoardManager
Stone *- Node
Node - Node

Move - History

Observer <|- GUI

@enduml