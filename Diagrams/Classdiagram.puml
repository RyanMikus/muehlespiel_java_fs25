@startuml
class Game {
- board: Board
- playerWhite: players.Player
- playerBlack: players.Player
- currentPlayer: players.Player
- gamePhase: Phase
- history: persistance.History
--
+ startGame()
+ switchPlayer()
+ checkGameOver()
+ getWinner()
+ undoMove()
+ redoMove()
+ saveGame()
+ loadGame()
}

class Board{
- fields: Field[][]
--
+ initializeBoard()
+ moveSTone()
+ isMillFormed()
+ removeSTone()
+ getValidMoves()
}

class boardLogic.Stone{
- owner: players.Player
- currentField: Field
--
+ moveTo()
}

class Field{
- position: Position
--
+ isOccupied()
}

class players.Player{
- name: String
- stones: List<boardLogic.Stone>
- isCPU: bool
--
+ placeStone()
+ removeStone()
+ moveStone()
}

class players.CPUPlayer{
- difficulty: Difficulty
--
+ calculateMove()
+ setDifficulty()
}

class view.GUI{
- game: Game
- boardPanel: JPanel
- controlPanel: JPanel
--
+ initializeGUI()
+ updateBoard()
+ handleUserInput()
+ showSaveDialog()
+ showLoadDialog()
+ setDifficulty()
}

class Phase{
- enum: ENUM
--
SETTING
MOVING
JUMPING
GAME OVER
}

class Difficulty{
- enum: ENUM
--
EASY
MEDIUM
HARD
}

class persistance.History{
- moves: Stack<persistance.Move>
- redoMoves: Stack<persistance.Move>
--
+ addMove(move:persistance.Move)
+ undo():persistance.Move
+ redo():persistance.Move
+ clearRedo()    
}

class persistance.Move{
- stone: boardLogic.Stone
- fromField: Field      
- toField: Field        
- removedStone: boardLogic.Stone
- phase: Phase          
}

Game --> Board
Board --> Field
Board --> boardLogic.Stone
players.CPUPlayer --|> players.Player
persistance.History --> persistance.Move
@enduml
