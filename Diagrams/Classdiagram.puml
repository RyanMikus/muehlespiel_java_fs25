@startuml
class Game {
- board: Board
- playerWhite: Player
- playerBlack: Player
- currentPlayer: Player
- gamePhase: Phase
- history: History
--
+ startGame()
+ switchPlayer()
+ checkGameOver()
+ getWinner()
+ undoMove()
+ redoMove()
+ saveGame()
+ loadGame()
}

class Board{
- fields: Field[][]
--
+ initializeBoard()
+ moveSTone()
+ isMillFormed()
+ removeSTone()
+ getValidMoves()
}

class Stone{
- owner: Player
- currentField: Field
--
+ moveTo()
}

class Field{
- position: Position
--
+ isOccupied()
}

class Player{
- name: String
- stones: List<Stone>
- isCPU: bool
--
+ placeStone()
+ removeStone()
+ moveStone()
}

class CPUPlayer{
- difficulty: Difficulty
--
+ calculateMove()
+ setDifficulty()
}

class GUI{
- game: Game
- boardPanel: JPanel
- controlPanel: JPanel
--
+ initializeGUI()
+ updateBoard()
+ handleUserInput()
+ showSaveDialog()
+ showLoadDialog()
+ setDifficulty()
}

class Phase{
- enum: ENUM
--
SETTING
MOVING
JUMPING
GAME OVER
}

class Difficulty{
- enum: ENUM
--
EASY
MEDIUM
HARD
}

class History{
- moves: Stack<Move>
- redoMoves: Stack<Move>
--
+ addMove(move:Move)    
+ undo():Move           
+ redo():Move           
+ clearRedo()    
}

class Move{
- stone: Stone          
- fromField: Field      
- toField: Field        
- removedStone: Stone   
- phase: Phase          
}

Game --> Board
Board --> Field
Board --> Stone
CPUPlayer --|> Player
History --> Move
@enduml
