@startuml

top to bottom direction

actor "Spieler 1" as act1 <<Mensch>>
actor "Spieler 2" as act2 <<Mensch>>
actor "KI-Gegner" as act3 <<Applikation>>

rectangle "Home" {
    usecase UC1 as "neues Spiel starten"
    usecase UC2 as "gespeichertes Spiel wiederaufnehmen"
    usecase UC3 as "Schwierigkeitsgrad einstellen"
    usecase UC4 as "maximale Bedenkzeit einstellen"
}

rectangle "Spiel" {
    usecase UC5 as "Spielzug machen"
    usecase UC6 as "Spielzug rückgängig machen"
    usecase UC7 as "Spiel abbrechen"
    usecase UC8 as "Spielzustand speichern"
}

' Spieler 1
act1 --> UC1
act1 --> UC2
act1 --> UC3
act1 <--> UC4
act1 --> UC5
act1 --> UC6
act1 --> UC7

' Spieler 2
act2 --> UC5
act2 --> UC6
act2 --> UC7

' KI-Gegner
act3 --> UC5

' Spielstart triggert andere Spieler/KI
UC1 --> act2
UC1 --> act3
UC2 --> act2
UC2 --> act3
UC3 --> act3
UC4 --> act2

' Extend-Beziehung
UC7 ..> UC8 : <<extend>>

@enduml